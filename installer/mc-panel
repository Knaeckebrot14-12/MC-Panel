#!/usr/bin/env bash
# Command line helper for a panel installed with install.sh.
# Installed as /usr/local/bin/mc-panel (a symlink to this file).

set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
INSTALL_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
COMPOSE_FILE="$INSTALL_DIR/docker-compose.prod.yml"

dc() {
    docker compose -f "$COMPOSE_FILE" --project-directory "$INSTALL_DIR" "$@"
}

usage() {
    cat <<'EOT'
mc-panel - manage your MC Panel installation

  mc-panel update [--force]   install the newest version now (same as the Update button)
  mc-panel status             show the running version and containers
  mc-panel logs [service]     follow logs (panel, database, cache, updater)
  mc-panel restart            restart all services
  mc-panel stop | start       stop or start all services
  mc-panel backup             back up the database and panel settings now
  mc-panel artisan <args>     run a panel artisan command, e.g. mc-panel artisan p:user:make
  mc-panel install-dir        print the install directory
EOT
}

case "${1:-}" in
    update)
        force=0
        [ "${2:-}" = "--force" ] && force=1
        exec bash "$INSTALL_DIR/installer/updater/updater.sh" run "manual-$(date +%s)" false "$force"
        ;;
    status)
        commit="$(dc exec -T panel cat /app/.mc-commit 2>/dev/null | tr -d '[:space:]')"
        echo "Version: $(cat "$INSTALL_DIR/VERSION" 2>/dev/null) (running commit: ${commit:-unknown})"
        echo "Install directory: $INSTALL_DIR"
        echo
        dc ps
        ;;
    logs)
        shift
        dc logs -f --tail 100 "${@:-panel}"
        ;;
    restart) dc restart ;;
    stop) dc stop ;;
    start) dc up -d ;;
    backup)
        # Reuse the updater's backup routine.
        # shellcheck disable=SC1090
        source <(sed -n '/^backup_data()/,/^}/p;/^log()/,/^}/p' "$INSTALL_DIR/installer/updater/updater.sh")
        STATE_DIR="$INSTALL_DIR/state"; LOG_FILE="$STATE_DIR/update.log"; BACKUP_DIR="$INSTALL_DIR/backups"; KEEP_BACKUPS=7
        backup_data
        echo "Backups are in $BACKUP_DIR"
        ;;
    artisan)
        shift
        exec docker compose -f "$COMPOSE_FILE" --project-directory "$INSTALL_DIR" exec panel php artisan "$@"
        ;;
    install-dir) echo "$INSTALL_DIR" ;;
    ""|-h|--help|help) usage ;;
    *)
        echo "Unknown command: $1" >&2
        usage >&2
        exit 2
        ;;
esac
