#!/usr/bin/env bash
# Command line helper for a panel installed with install.sh.
# Installed as /usr/local/bin/recoded-ptero (a symlink to this file).

set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
INSTALL_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
COMPOSE_FILE="$INSTALL_DIR/docker-compose.prod.yml"

dc() {
    docker compose -f "$COMPOSE_FILE" --project-directory "$INSTALL_DIR" "$@"
}

usage() {
    cat <<'EOT'
recoded-ptero - manage your Recoded Ptero installation

  recoded-ptero update [--force]   install the newest version now (same as the Update button)
  recoded-ptero status             show the running version and containers
  recoded-ptero logs [service]     follow logs (panel, database, cache, updater)
  recoded-ptero restart            restart all services
  recoded-ptero stop | start       stop or start all services
  recoded-ptero backup             back up the database and panel settings now
  recoded-ptero certs              show the SSL certificates and when they expire
  recoded-ptero artisan <args>     run a panel artisan command, e.g. recoded-ptero artisan p:user:make
  recoded-ptero install-dir        print the install directory
EOT
}

case "${1:-}" in
    update)
        force=0
        [ "${2:-}" = "--force" ] && force=1
        exec bash "$INSTALL_DIR/installer/updater/updater.sh" run "manual-$(date +%s)" false "$force"
        ;;
    status)
        commit="$(dc exec -T panel cat /app/.mc-commit 2>/dev/null | tr -d '[:space:]')"
        echo "Version: $(cat "$INSTALL_DIR/VERSION" 2>/dev/null) (running commit: ${commit:-unknown})"
        echo "Install directory: $INSTALL_DIR"
        echo
        dc ps
        ;;
    logs)
        shift
        dc logs -f --tail 100 "${@:-panel}"
        ;;
    restart) dc restart ;;
    stop) dc stop ;;
    start) dc up -d ;;
    backup)
        # Reuse the updater's backup routine.
        # shellcheck disable=SC1090
        source <(sed -n '/^backup_data()/,/^}/p;/^log()/,/^}/p' "$INSTALL_DIR/installer/updater/updater.sh")
        STATE_DIR="$INSTALL_DIR/state"; LOG_FILE="$STATE_DIR/update.log"; BACKUP_DIR="$INSTALL_DIR/backups"; KEEP_BACKUPS=7
        backup_data
        echo "Backups are in $BACKUP_DIR"
        ;;
    artisan)
        shift
        exec docker compose -f "$COMPOSE_FILE" --project-directory "$INSTALL_DIR" exec panel php artisan "$@"
        ;;
    certs)
        # The panel's certificate lives in its container, Wings' certificate on this server.
        echo "Panel certificate:"
        dc exec -T panel php artisan p:ssl:renew 2>/dev/null | sed 's/^/  /'
        if command -v certbot >/dev/null 2>&1; then
            echo
            echo "Certificates on this server (Wings):"
            certbot certificates 2>/dev/null | grep -E "Certificate Name|Expiry Date" | sed 's/^ */  /'
        fi
        echo
        echo "All certificates are checked twice a day and renewed 30 days before they expire."
        ;;
    install-dir) echo "$INSTALL_DIR" ;;
    ""|-h|--help|help) usage ;;
    *)
        echo "Unknown command: $1" >&2
        usage >&2
        exit 2
        ;;
esac
